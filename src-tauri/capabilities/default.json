{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "sql:default",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "codex-cli",
          "cmd": "codex",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
